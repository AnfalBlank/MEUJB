# Turso Cloud SQLite Database
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token"

# ==============================================================================
# Google Drive API v3 (PILIHAN 1: OAuth 2.0 - SANGAT DIREKOMENDASIKAN UNTUK AKUN PRIBADI 15GB)
# ==============================================================================
# 1. Buat OAuth Client ID (Web Application) di Google Cloud Console
# 2. Tambahkan Authorized Redirect URI: http://localhost:3001/api/drive/callback (atau domain produksi Anda)
# 3. Kunjungi http://localhost:3001/api/drive/auth untuk generate GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REFRESH_TOKEN="your-refresh-token"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/drive/callback"

# Folder Utama di Google Drive
GDRIVE_ROOT_FOLDER_ID="your-google-drive-root-folder-id"

# ==============================================================================
# Google Drive API v3 (PILIHAN 2: Service Account - Khusus Google Workspace Shared Drive)
# ==============================================================================
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
